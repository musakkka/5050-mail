# 5050 Mail settings. install.sh writes the real file to /opt/5050-mail/.env (mode 0600)
# and generates every secret; this file documents the keys. Re-running install.sh keeps
# existing values.

# ---- Domains and hostnames --------------------------------------------------
MAIL_DOMAIN=example.com              # primary mail domain (more can be added in the admin console)
MAIL_HOSTNAME=mail.example.com       # webmail + SMTP/IMAP host; the MX target; needs an A record
SEND_HOST=send.example.com           # 5050 Send dashboard
API_HOST=api.example.com             # 5050 Send API (Resend-compatible)
ADMIN_EMAIL=admin@example.com        # first admin mailbox (created on first install)
ACME_EMAIL=admin@example.com         # Let's Encrypt contact
SUPPORT_EMAIL=postmaster@example.com # shown in the Send dashboard's help links
PUBLIC_IPV4=                         # detected by install.sh; used in the printed DNS records
PUBLIC_IPV6=

# ---- TLS --------------------------------------------------------------------
TLS_MODE=acme                        # acme | internal (self-signed, for test domains)
CADDY_GLOBAL_OPTIONS=                # "local_certs" when TLS_MODE=internal
CADDY_CERT_ISSUER=acme-v02.api.letsencrypt.org-directory   # "local" when TLS_MODE=internal
STALWART_TLS_MODE=acme               # acme (HTTP-01 through Caddy, or DNS-01 with Cloudflare) | manual

# ---- Secrets (generated) ----------------------------------------------------
POSTGRES_PASSWORD=change-me
STALWART_DB_PASSWORD=change-me
SEND_DB_PASSWORD=change-me
WEBMAIL_DB_PASSWORD=change-me
STALWART_ADMIN=recovery:change-me    # Stalwart recovery admin (internal network only)
WEBMAIL_SESSION_SECRET=change-me-at-least-32-characters-long
SEND_SESSION_SECRET=change-me-at-least-32-characters-long

# ---- Outbound delivery ------------------------------------------------------
# Default: direct delivery to recipients' MX on port 25. If your provider blocks
# outbound 25, set a relay (Amazon SES, Postmark, Mailgun, Cloudflare Email Service, ...).
RELAY_HOST=
RELAY_PORT=587                       # 465 = implicit TLS, 587 = STARTTLS
RELAY_USERNAME=
RELAY_PASSWORD=

# ---- Cloudflare (optional) --------------------------------------------------
# With a token (Zone:Read + DNS:Edit): install.sh creates the DNS records, Stalwart gets
# certificates with DNS-01 and keeps MX/SPF/DKIM/DMARC published, and the admin console
# offers one-click setup for new domains in the account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE=                     # only if the zone is not MAIL_DOMAIN itself
CLOUDFLARE_EMAIL_SENDING=0           # 1 only when RELAY_HOST is Cloudflare Email Service

# ---- 5050 Send --------------------------------------------------------------
SEND_TRANSPORT=smtp                  # smtp (via the mail server) | log (drop, for testing)
SEND_DOMAIN_RECORDS=local            # local: own DKIM keys, public-DNS verification
SEND_DEFAULT_RATE_LIMIT=10           # requests/second per team (per process)
SEND_DEFAULT_MONTHLY_QUOTA=50000
SEND_WORKER_CONCURRENCY=1
SEND_SMTP_CONCURRENCY=1
SEND_PG_POOL_MAX=5
DOCS_BASE=https://github.com/musakkka/5050-mail

# ---- Scaling ----------------------------------------------------------------
WEB_CONCURRENCY=auto                 # processes per Node service (auto = one per CPU core)
INTERNAL_SUBNET=172.30.50.0/24       # docker network for the stack
IMAGE_PREFIX=ghcr.io/musakkka/5050-mail
VERSION=latest
DNS_SERVERS=                         # resolvers for the admin console's "Check DNS" (default: system)
